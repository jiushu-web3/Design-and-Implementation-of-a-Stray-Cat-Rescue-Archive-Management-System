<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.Master.cs" Inherits="StrayCat.Web.SiteMaster" %>
<!DOCTYPE html>
<html>
<head runat="server">
    <meta charset="utf-8" />
    <title>流浪猫救助档案管理系统</title>
    <link rel="stylesheet" href="Content/css/site.css" />
</head>
<body>
    <form id="MainForm" runat="server" enctype="multipart/form-data">
        <div class="shell">
            <aside class="side">
                <div class="brand">
                    <p class="brand-mark">档案</p>
                    <h1>流浪猫救助档案管理系统</h1>
                </div>
                <nav class="menu">
                    <a href="Default.aspx">首页</a>
                    <p class="menu-label">领养与上报</p>
                    <a href="Adoptable.aspx">可领养猫</a>
                    <a href="ReportAdd.aspx">上报流浪猫</a>
                    <a href="MyCenter.aspx">我的中心</a>
                    <asp:PlaceHolder ID="AdminMenu" runat="server" Visible="false">
                        <p class="menu-label">审核</p>
                        <a href="ReportList.aspx">上报审核</a>
                        <p class="menu-label">档案管理</p>
                        <a href="CatList.aspx">档案查询</a>
                        <a href="CatAdd.aspx">建立档案</a>
                        <p class="menu-label">医疗管理</p>
                        <a href="MedicalList.aspx">诊疗历史</a>
                        <p class="menu-label">领养管理</p>
                        <a href="AdoptionList.aspx">领养记录</a>
                        <p class="menu-label">回访管理</p>
                        <a href="FollowUpList.aspx">回访历史</a>
                        <p class="menu-label">统计报表</p>
                        <a href="Stat.aspx">月度统计</a>
                        <p class="menu-label">用户管理</p>
                        <a href="UserList.aspx">用户列表</a>
                    </asp:PlaceHolder>
                    <a href="ChangePassword.aspx">修改密码</a>
                </nav>
            </aside>
            <div class="workspace">
                <header class="top">
                    <p>当前用户：<asp:Literal ID="UserLiteral" runat="server" /></p>
                    <asp:LinkButton ID="LogoutButton" runat="server" CssClass="link-button" CausesValidation="false" OnClick="LogoutButton_Click" Text="退出" />
                </header>
                <div class="content">
                    <asp:ContentPlaceHolder ID="MainContent" runat="server" />
                </div>
            </div>
        </div>
    </form>
    <script src="Content/js/site.js"></script>
</body>
</html>
